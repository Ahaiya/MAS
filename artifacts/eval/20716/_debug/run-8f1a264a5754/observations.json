      "end_offset": 2196,
      "unit_type": "sentence",
      "sequence_index": 24,
      "chunk_title": null,
      "chunk_method": "rule"
    },
    {
      "unit_id": "unit-855eb8f99526",
      "document_id": "doc-f34ce0393252",
      "text": "I said &lt;@CAPS1 sounds like a plan&gt;.",
