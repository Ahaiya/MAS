      "chunk_method": "rule"
    },
    {
      "unit_id": "unit-6f8d9627c091",
      "document_id": "doc-f34ce0393252",
      "text": "@PERSON1 told @ORGANIZATION1 shecould sit in the back in between @PERSON2 and I.",
