      "end_offset": 2238,
      "unit_type": "sentence",
      "sequence_index": 25,
      "chunk_title": null,
      "chunk_method": "rule"
    },
    {
      "unit_id": "unit-7e866900b553",
      "document_id": "doc-f34ce0393252",
      "text": "I asked mt mom if it was @CAPS1 if I could spend the night at @PERSON2 house she said &lt;yeah just make sure its @CAPS1 with his mom&gt;.",
      "start_offset": 2239,
      "end_offset": 2377,
      "unit_type": "sentence",
      "sequence_index": 26,
      "chunk_title": null,
      "chunk_method": "rule"
    },
    {
      "unit_id": "unit-eca11696ac6a",
      "document_id": "doc-f34ce0393252",
      "text": "@PERSON2 asked his mom she said it was @CAPS1.",
