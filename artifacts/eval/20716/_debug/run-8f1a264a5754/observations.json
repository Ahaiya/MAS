      "unit_type": "sentence",
      "sequence_index": 37,
      "chunk_title": null,
      "chunk_method": "rule"
    },
    {
      "unit_id": "unit-934596909ca1",
      "document_id": "doc-f34ce0393252",
      "text": "The next morning when my mom came to pick me up she asked me how the sleep over went.",
