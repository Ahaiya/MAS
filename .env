# 全局 LLM 默认值
# 这组配置主要承担两件事：
# 1. 作为外环未显式覆盖时的回退值
# 2. 作为其他 provider entry 留空时的通用 fallback
# 评价主流水线真正的模型路由，优先看
# configs/bundles/engineering_eval_baseline.bundle.yaml 中的 provider_config。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-8b3d61ebedb14ce0b251654095381e1f
LLM_API_BASE=https://api.deepseek.com/v1

# 外环主 Agent 专用配置
# scripts/outer_loop.py 优先读取这一组。
# 推荐做法：
# - 想调外环模型或参数，直接改这里
# - OUTER_LOOP_API_KEY 留空即可复用 LLM_API_KEY
# - 只有你明确想回退到全局默认时，才把 model/api_base 留空
OUTER_LOOP_MODEL=deepseek-chat
OUTER_LOOP_API_KEY=
OUTER_LOOP_API_BASE=https://api.deepseek.com/v1
OUTER_LOOP_TEMPERATURE=0.0
OUTER_LOOP_MAX_TOKENS=2048

# 通用运行参数
# 这组参数影响 provider 调用层的超时、重试与缓存行为，
# 不用于定义评价主流水线“应该使用哪个模型”。
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1
LLM_CACHE_ENABLED=false
LLM_CACHE_DIR=.cache/llm
LLM_RATE_LIMIT_RPM=60
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# 可选：系统提示词覆盖（仅实验用途）
# 正式 prompt 仍应来自 configs/prompts/*.yaml。
# LLM_SYSTEM_PROMPT_OVERRIDE=

# 评价主流水线各角色的密钥
# 工程评价 baseline 的模型/路由由 bundle 决定，这里只放 secret。
# 任一角色的 API key 留空时，运行时会自动回退到 LLM_API_KEY。
# 因此最小可用配置通常只需要填 LLM_API_KEY。
RATER_1_API_KEY=
RATER_2_API_KEY=sk-df8e8eda4bf64b5a943d3e7a40986b79
RATER_3_API_KEY=
CHUNKING_API_KEY=
COVERAGE_API_KEY=
EXTRACTOR_API_KEY=
FEEDBACK_API_KEY=
