# LLM Provider Configuration
# This file demonstrates the LLM-agnostic provider interface.
# The system supports multiple providers through a unified adapter layer.

# LLM Provider: 'mock', 'openai', 'anthropic', 'deepseek', etc.
LLM_PROVIDER=deepseek

# Model name - depends on the provider
# OpenAI examples: gpt-4-turbo, gpt-3.5-turbo
# Anthropic examples: claude-3-opus-20240229, claude-3-sonnet-20240229
LLM_MODEL=deepseek-chat

# API Key for the LLM provider (required for non-mock providers)
LLM_API_KEY=sk-8b3d61ebedb14ce0b251654095381e1f

# API Base URL - only needed if using a custom endpoint
# Leave empty for provider default
LLM_API_BASE=https://api.deepseek.com/v1

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=60

# Maximum retry attempts for failed requests
LLM_MAX_RETRIES=3

# Retry delay in seconds
LLM_RETRY_DELAY_SECONDS=1

# Whether to cache LLM responses (for reproducibility in dev mode)
LLM_CACHE_ENABLED=false

# Cache directory for LLM responses (relative to project root)
LLM_CACHE_DIR=.cache/llm

# Optional: Request rate limiting (requests per minute)
LLM_RATE_LIMIT_RPM=60

# Optional: Temperature for generation (0.0 = deterministic, 1.0 = random)
# Default varies by provider; override only for specific experiments
LLM_TEMPERATURE=

# Optional: Max tokens in response
# Default varies by provider; override only for specific experiments
LLM_MAX_TOKENS=

# Optional: System prompt override (for experimentation only)
# Production system prompts should come from configs/prompts/*.yaml
# LLM_SYSTEM_PROMPT_OVERRIDE=

# ── Per-Rater Provider Keys (Path B: bundle-driven multi-LLM) ─────────────────
# Used when configs/bundles/*.bundle.yaml declares a provider_config section.
# Each rater_providers entry references one of these env var names via api_key_env.
# Leave a key empty to fall back to LLM_API_KEY for that rater.
#
# Rater 1 (first independent scorer)
RATER_1_API_KEY=
# RATER_1_MODEL and RATER_1_API_BASE are set directly in the bundle YAML,
# not as env vars, since they are not secrets.

# Rater 2 (second independent scorer)
RATER_2_API_KEY=

# Rater 3 (resolution scorer, invoked only on conflict)
RATER_3_API_KEY=

# ── Per-Stage Provider Keys ───────────────────────────────────────────────────
# Evidence extraction stage
EXTRACTOR_API_KEY=

# Feedback / explanation assembly stage
FEEDBACK_API_KEY=
