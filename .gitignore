# macOS
.DS_Store

# Python 字节码
__pycache__/
*.py[cod]
*.egg-info/

# uv / 虚拟环境
# 注意：uv.lock 与 .python-version 是有意入库的，不要加到这里。
.venv/
venv/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 测试覆盖率
.coverage
.coverage.*
coverage.xml
htmlcov/

# 构建产物
dist/
build/
*.whl

# IDE
.idea/
.vscode/

# 密钥：只入库 .env.example 模板
.env
.env.*
!.env.example

# Claude Code：本地个人配置与 worktree 不入库
.claude/settings.local.json
.claude/worktrees/

# 学生材料：以学号命名的原始文本，隐私敏感，一律不入库
# 必须锚定：不带斜杠的 data/ 会连 frontend/src/data/ 的源码一起吃掉。
/data/

# 评测运行产物
/artifacts/

# 解析结果（原件 + 数据包）：学生材料的完整内容，隐私敏感，一律不入库
/packages/
